  "main": "index.js",
  "scripts": {
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test -- --watchAll=false",
    "test:e2e": "playwright test",
    "setup:dev": "cd server && npm install && tsc && cd ../client && npm install",
    "serve:client": "cd client && npm start",
    "serve:server": "cd server && tsc && npm start",
    "setup:docker": "docker-compose --progress plain up -d --build",
    "prepare": "husky"
  },
